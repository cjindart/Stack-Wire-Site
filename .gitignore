# Secrets — never commit these
.env
.env.*
!.env.example

# Build output (regenerated by CI on every push)
dist/

# Narration audio IS committed (not ignored) — scripts/generate-audio.mjs
# skips re-calling OpenAI when today's mp3 already exists in the repo, so a
# UI-only push (editing scripts/build-site.mjs etc.) rebuilds and redeploys
# for free instead of re-narrating and burning API credits.

node_modules/
