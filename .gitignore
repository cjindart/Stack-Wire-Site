# Secrets — never commit these
.env
.env.*
!.env.example

# Build output (regenerated by CI on every push)
dist/

# Generated narration audio (regenerated by CI — keep the repo light).
# Remove this line if you'd rather commit audio files directly instead of
# regenerating them in every CI run.
audio/*.mp3
!audio/.gitkeep

node_modules/
.DS_Store
