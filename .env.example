# Copy this file to .env and fill in your real key. .env is gitignored —
# it will never be committed, never pushed, never seen by anyone but you
# and the OpenAI API call itself.
#
#   cp .env.example .env
#
# Get a key at https://platform.openai.com/api-keys — consider creating a
# key scoped to a project used only for this, with a monthly spend cap set
# in the OpenAI dashboard, so a worst case is bounded.

OPENAI_API_KEY=sk-...

# Optional overrides — see https://platform.openai.com/docs/guides/text-to-speech
# for current model names, available voices, and pricing.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
